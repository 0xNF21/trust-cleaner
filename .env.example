# Public app URL
NEXT_PUBLIC_APP_URL=https://trust-cleaner.vercel.app

# Database for auth challenges, sessions, claimed payments and refunds
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Circles RPC
NEXT_PUBLIC_CIRCLES_RPC_URL=https://rpc.aboutcircles.com/

# Trust score enrichment, same analytics source used by CRC Boost
GARAGE_TRUST_SCORE_API_URL=https://squid-app-3gxnl.ondigitalocean.app/aboutcircles-advanced-analytics2
TRUST_CLEANER_SCORE_CACHE_SECONDS=600

# Standalone auth proof recipient
SAFE_ADDRESS=0x...

# Automatic 1 CRC auth refund
# Token address held by SAFE_ADDRESS and sent back to the payer as ERC-1155 CRC.
AUTH_REFUND_TOKEN_ADDRESS=0x...
BOT_PRIVATE_KEY=
ROLES_MODIFIER_ADDRESS=
ROLE_KEY=
